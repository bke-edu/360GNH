# The demo binds to loopback and uses a deterministic local model by default.
HOST=127.0.0.1
PORT=4310
WEB_ORIGIN=http://127.0.0.1:4311

# Required if HOST is not loopback. Docker also uses it only between the web proxy and API.
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Optional real-model adapter. Leave empty for the no-key local demo.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_BUDGET_USD=1

# Required only when OPENAI_MODEL is not in the built-in price table.
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=

# Optional single-video YouTube transcript import. This key stays server-side.
SUPADATA_API_KEY=

# Optional one-file WAV audiobook rendering. OPENAI_API_KEY above is reused.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
AUDIOBOOK_MAX_CHARS=20000
AUDIOBOOK_SESSION_CHAR_BUDGET=100000

# Optional outside Docker. The default is apps/api/data/provider-settings.json.
# Docker Compose uses its private named volume instead.
PROVIDER_SETTINGS_PATH=
